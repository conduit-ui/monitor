{
    "name": "conduit-ui/monitor",
    "description": "Monitoring CLI for the Conduit agent ecosystem",
    "keywords": [
        "cli",
        "monitor",
        "conduit-ui"
    ],
    "homepage": "https://github.com/conduit-ui/monitor",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/conduit-ui/monitor/issues",
        "source": "https://github.com/conduit-ui/monitor"
    },
    "authors": [
        {
            "name": "Jordan Partridge",
            "email": "jordan@partridge.rocks"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "monitor"
    ]
}
